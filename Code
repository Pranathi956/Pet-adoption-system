int main() {  

  

    while (true) {  

        Pet* pet = createPet();  

        if (!pet) {  

            cout << "Exiting..Thank you!" << endl;  

            break;  

        }  

        pet->displayInitialInfo();  

        string confirmation;  

        cout << "Do you like this choice? (y/n): ";  

        cin >> confirmation;  

        if (confirmation == "y"||confirmation=="Y") {  

            pet->displayAdditionalInfo();  

            cout << "Price: $" << pet->getPrice() << endl;  

            cout << "Do you want to adopt this pet? (y/n): ";  

            string adoptconfirmation;  

            cin >> adoptconfirmation;  

            if (adoptconfirmation=="y"||adoptconfirmation=="Y") {  

                cout << "\nThey have found their happy place..Thanks to you!\n" << endl;  

            } else {  

                cout << "Pet adoption cancelled." << endl;  

            }  

        } else {  

            cout << "Pet adoption cancelled." << endl;  

        }  

        delete pet;   

    }  

    return 0;  

}
