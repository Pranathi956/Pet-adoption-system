#include <iostream>  

#include <string>  

using namespace std;  

class Pet {  

protected:  

    string age;  

    string size;  

    string color;  

    string lifespan;  

    string gender;  

public:  

    Pet(string age, string size, string color, string lifespan, string gender) 

        : age(age), size(size), color(color), lifespan(lifespan), gender(gender) {}  

    virtual void displayInitialInfo() = 0;   

    virtual void displayAdditionalInfo() = 0;   

    virtual double getPrice() = 0;   

};  

class Dog : public Pet {  

private:  

    string breed;  

    double price;  

    string healthStatus;  

    string personalityTraits;  

    string trainingLevel;  

    string adoptionRequirements;  

    string groomingNeeds;  

public:  

    Dog(string breed, string age, string size, string color, string lifespan, string gender, double price, string healthStatus, string personalityTraits,  

        string trainingLevel, string adoptionRequirements, string groomingNeeds)  

        : Pet(age, size, color, lifespan, gender), breed(breed), price(price), healthStatus(healthStatus), personalityTraits(personalityTraits),  

trainingLevel(trainingLevel), adoptionRequirements(adoptionRequirements), groomingNeeds(groomingNeeds) {}  

    void displayInitialInfo() override {  

        cout << "Dog Breed: " << breed << endl;  

        cout << "Age: " << age << ", Size: " << size << ", Color: " << color  

             << ", Lifespan: " << lifespan << ", Gender: " << gender << endl;  

    }  

    void displayAdditionalInfo() override {  

        cout << "Health Status: " << healthStatus << endl;  

        cout << "Personality Traits: " << personalityTraits << endl;  

        cout << "Training Level: " << trainingLevel << endl;  

        cout << "Adoption Requirements: " << adoptionRequirements << endl;  

        cout << "Grooming Needs: " << groomingNeeds << endl;  

    }  

    double getPrice() override {  

        return price;  

    }  

};  

